{
    "schemaVersion": 1,
    "id": "${id}",
    "version": "${version}",
    "name": "${name}",
    "description": "viaLogium logs world events and allows rollbacks with database-backed history",
    "authors": [
        "viaMeowts"
    ],
    "contact": {
        "homepage": "https://github.com/viaMeowts/viaLogium",
        "sources": "https://github.com/viaMeowts/viaLogium",
        "issues": "https://github.com/viaMeowts/viaLogium/issues"
    },
    "license": "LGPL",
    "icon": "assets/vialogium/icon.png",
    "environment": "server",
    "entrypoints": {
        "server": [
            {
                "value": "com.viameowts.vialogium.ViaLogium::INSTANCE"
            }
        ]
    },
    "mixins": [
        "vialogium.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.16.2",
        "fabric": ">=0.133.13+1.21.9",
        "fabric-language-kotlin": ">=${fabricKotlin}",
        "minecraft": ">=1.21.11",
        "viapanel": "*"
    },
    "breaks": {
        "cardboard": "*"
    }
}
